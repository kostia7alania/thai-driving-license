---
import { PublicSiteFooter, PublicSiteHeader } from "@/widgets/public-site-chrome";

interface Props {
  name: "calendar" | "compare" | "history" | "map";
}

const { name } = Astro.props;
---

<div class={`${name}-page tw:flex tw:min-h-screen tw:flex-col tw:bg-background tw:text-foreground`}>
  <PublicSiteHeader />
  <slot />
  <PublicSiteFooter />
</div>
