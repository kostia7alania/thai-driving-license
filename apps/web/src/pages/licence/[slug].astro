---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import SiteLayout from "@/app/layouts/site-layout.astro";
import { JOURNEYS, LICENCE_PATH_SEGMENT } from "@/entities/guide";
import { SITE_URL } from "@/shared/config/site";
import { breadcrumbList } from "@/shared/lib/json-ld";
import { LicenceJourneyPage } from "@/views/licence-journey";

export const getStaticPaths = (() =>
  JOURNEYS.map((journey) => ({
    params: { slug: journey.slug },
    props: { journey },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { journey } = Astro.props;
const path = `/${LICENCE_PATH_SEGMENT}/${journey.slug}`;
const structuredData = breadcrumbList([
  { name: "Home", item: `${SITE_URL}/` },
  { name: "Licence questions", item: `${SITE_URL}/${LICENCE_PATH_SEGMENT}` },
  { name: journey.cardTitle, item: `${SITE_URL}${path}` },
]);
---

<SiteLayout
  title={journey.title}
  description={journey.metaDescription}
  canonical={path}
  openGraph={{ title: journey.title, description: journey.metaDescription, path, type: "article", modifiedTime: journey.updatedOn }}
  structuredData={structuredData}
>
  <LicenceJourneyPage journey={journey} />
</SiteLayout>
