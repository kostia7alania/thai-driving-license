---
import SiteLayout from "@/app/layouts/site-layout.astro";
import ToolLayout from "@/app/layouts/tool-layout.astro";
import { PUBLIC_SLOT_TOOLS_ENABLED } from "@/shared/config/site";
import { BffRequiredPage } from "@/views/bff-required";
import { ComparePage } from "@/views/compare";

const title = PUBLIC_SLOT_TOOLS_ENABLED ? "Compare DLT Offices" : "Office Comparison Unavailable";
const description = PUBLIC_SLOT_TOOLS_ENABLED
  ? "Compare Thai DLT appointment availability across offices side by side."
  : "Appointment comparison requires the full Thai Driving License backend.";
---

<SiteLayout title={title} description={description} canonical="/compare" index={PUBLIC_SLOT_TOOLS_ENABLED}>
  <ToolLayout name="compare">
    {PUBLIC_SLOT_TOOLS_ENABLED ? <ComparePage client:load /> : <BffRequiredPage toolName="Office comparison" />}
  </ToolLayout>
</SiteLayout>
