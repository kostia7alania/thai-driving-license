---
import SiteLayout from "@/app/layouts/site-layout.astro";
import ToolLayout from "@/app/layouts/tool-layout.astro";
import { PUBLIC_SLOT_TOOLS_ENABLED } from "@/shared/config/site";
import { BffRequiredPage } from "@/views/bff-required";
import { CalendarPage } from "@/views/calendar";

const title = PUBLIC_SLOT_TOOLS_ENABLED
  ? "DLT Appointment Calendar"
  : "Appointment Calendar Unavailable";
const description = PUBLIC_SLOT_TOOLS_ENABLED
  ? "Browse Thai DLT appointment availability by office and work option."
  : "The appointment calendar requires the full Thai Driving License backend.";
---

<SiteLayout title={title} description={description} canonical="/calendar" index={PUBLIC_SLOT_TOOLS_ENABLED}>
  <ToolLayout name="calendar">
    {PUBLIC_SLOT_TOOLS_ENABLED ? <CalendarPage client:load /> : <BffRequiredPage toolName="The appointment calendar" />}
  </ToolLayout>
</SiteLayout>
